# Copy to .env.local for local development. Never commit a populated secret file.
OPENAI_API_KEY=
WORKSPACE_PASSWORD=
HOST=127.0.0.1
PORT=8080
# Timestamp compatibility model. See README migration note before 2027-02-26.
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_HIGHLIGHT_MODEL=gpt-4.1-mini
# Azure deployment uses managed identity and a private Blob container.
AZURE_STORAGE_URL=
AZURE_STORAGE_CONTAINER=cvyclip-private
