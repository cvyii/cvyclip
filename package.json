{
  "name": "cvyclip-site",
  "version": "2.0.0",
  "private": true,
  "description": "CvyClip AI video clipping studio and public website",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env.local studio/server.mjs",
    "start:site": "node scripts/serve.mjs",
